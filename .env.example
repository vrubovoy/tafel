# Tafel — Task Tracker

# Browser targets passed to the frontend image build by docker-compose.yml
SCHLUSSEL_WEB_URL=https://auth.localhost
SCHLOSS_URL=https://localhost

# Tafel API (host-side Compose variables)
TAFEL_DATABASE_PATH=/data/tafel.db
SCHLUSSEL_JWKS_URL=http://schlussel:4000/.well-known/jwks.json
JWT_ISSUER=schlussel
# Compose maps this host-side name to the backend's ALLOWED_ORIGINS variable.
TAFEL_ALLOWED_ORIGINS=https://localhost,https://tafel.localhost

# /exports/me accepts access JWTs and exact Tafel export delegations through
# the same JWKS/issuer. Tafel stores no ZIPs and needs no export-specific secret;
# the all-services artifact TTL and quotas are owned by Schlussel.

# Notification outbox delivery to Glocke (see backend/src/features/notifications/).
# TAFEL_TO_GLOCKE_HMAC_SECRET must match Glocke's own
# GLOCKE_SOURCE_SECRET_TAFEL exactly, and must be distinct from every
# other service's own HMAC secret - generate with e.g. `openssl rand -hex 32`.
# Left unset, due-date events still get recorded but queue up undelivered
# rather than crashing the service.
GLOCKE_BASE_URL=http://glocke-backend:3004
TAFEL_TO_GLOCKE_HMAC_KEY_ID=tafel-v1
TAFEL_TO_GLOCKE_HMAC_SECRET=replace-with-at-least-32-random-bytes
